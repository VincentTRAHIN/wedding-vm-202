# Supabase Configuration
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SERVICE_ROLE_KEY=your-service-role-key

# Email Configuration (Resend)
# ⚠️ CRITICAL: Must use your VERIFIED domain email (not noreply@ or onboarding@)
# Verify your domain in Resend Dashboard first: https://resend.com/domains
RESEND_API_KEY=re_your_api_key
SENDER_EMAIL=mariage@yourdomain.com
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Site Configuration
WEDDING_ACCESS_CODE=your-secret-code
ORIGIN=https://yourdomain.com

# Node Environment
NODE_ENV=production
